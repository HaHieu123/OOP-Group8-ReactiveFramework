# Auto-detect text files, normalize line endings
* text=auto eol=lf

# Explicit text files
*.cpp       text eol=lf
*.hpp       text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
LICENSE     text eol=lf

# Binary files
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.a         binary
*.lib       binary
*.png       binary
*.jpg       binary
*.pdf       binary

# Linguist - không đếm trong thống kê
build/      linguist-vendored